{
  "manifest_version": 3,
  "name": "YouMentor AI",
  "version": "2.0.0",
  "description": "Multilingual YouTube learning assistant with live subtitles and translated speech.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_title": "YouMentor AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
